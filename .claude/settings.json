{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/safety-detect.ts\"",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(mcp__.+__(plan_workout_day|plan_workout_range|update_planned_workout|move_planned_workout|skip_planned_workout|delete_planned_workout|update_user_profile|update_training_limits)|Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/urgent-gate.ts\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*[Tt]ally.*__(get_planned_workout|get_training_context|get_workout_history|plan_workout_day|plan_workout_range|update_planned_workout|move_planned_workout|skip_planned_workout|delete_planned_workout|update_user_profile|update_training_limits)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/capture-reads.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*[Tt]ally.*__(plan_workout_day|plan_workout_range|update_planned_workout|move_planned_workout|skip_planned_workout|delete_planned_workout|update_user_profile|update_training_limits)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-writes.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-check.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node engine/cli.ts mode)",
      "Bash(node engine/cli.ts window-check *)",
      "Bash(node engine/cli.ts readiness *)",
      "Bash(node engine/cli.ts signals *)",
      "Bash(node engine/cli.ts checkin *)",
      "Bash(node engine/cli.ts weeks *)",
      "Bash(node engine/cli.ts targets *)",
      "Bash(node engine/cli.ts block draft *)",
      "Bash(node engine/cli.ts ids next *)",
      "Bash(node engine/cli.ts adjust *)",
      "Bash(node engine/cli.ts loads *)",
      "Bash(node engine/cli.ts volume *)",
      "Bash(node engine/cli.ts classify *)",
      "Bash(node engine/cli.ts opid *)",
      "Bash(node engine/cli.ts oplog done *)",
      "Bash(node engine/cli.ts limits schema)",
      "Bash(node engine/cli.ts limits regions)",
      "Bash(node engine/cli.ts limits check *)",
      "Bash(node engine/cli.ts safety scan-notes *)",
      "Bash(node engine/cli.ts snapshot show)",
      "Bash(node engine/cli.ts lint-methods *)",
      "Bash(node engine/cli.ts config-check)",
      "Bash(node engine/cli.ts urgent status)",
      "Bash(node engine/cli.ts urgent set *)",
      "Bash(node engine/cli.ts urgent clear --reason clinician)",
      "Bash(node engine/cli.ts urgent clear --reason false-alarm)",
      "Bash(node engine/cli.ts install-git-hooks)",
      "Bash(node engine/cli.ts prepush-check)",
      "Bash(node engine/cli.ts push)",
      "Bash(node engine/cli.ts update --check)",
      "Bash(node engine/cli.ts help)",
      "Bash(node engine/cli.ts help *)",
      "Bash(node engine/cli.ts plans write *)",
      "Bash(node engine/cli.ts plans read *)",
      "Bash(node engine/cli.ts plans done *)",
      "Bash(node engine/cli.ts setup-check)",
      "Bash(node engine/cli.ts init-athlete)",
      "Bash(node engine/cli.ts allow-server *)",
      "Bash(node engine/cli.ts worktree status)",
      "Bash(node engine/cli.ts worktree ff-main)",
      "Bash(node engine/cli.ts worktree ff-branch)",
      "Bash(node engine/cli.ts commit --message *)",
      "Bash(node engine/cli.ts tally-mention)",
      "Bash(node engine/cli.ts tally-mention *)",
      "Bash(node engine/cli.ts push --branch main)",
      "Bash(node engine/cli.ts update --check --root *)",
      "Bash(node engine/cli.ts update --yes --to *)",
      "Bash(node engine/cli.ts logger set *)",
      "Bash(node engine/cli.ts worktree main-checkout)",
      "Bash(node engine/cli.ts worktree remove-temp)",
      "Bash(node engine/cli.ts history-files)",
      "Bash(npm ci)",
      "Bash(git -C * merge --ff-only *)",
      "Bash(node adapters/signals/oura/fetch.ts *)",
      "Bash(git pull --rebase)",
      "Edit(athlete/**)",
      "Edit(/athlete/**)",
      "Edit(plans/**)",
      "Edit(/plans/**)",
      "Edit(coach.yaml)",
      "Edit(/coach.yaml)",
      "Edit(.tmp/coach/**)",
      "Edit(/.tmp/coach/**)",
      "Write(athlete/**)",
      "Write(/athlete/**)",
      "Write(plans/**)",
      "Write(/plans/**)",
      "Write(coach.yaml)",
      "Write(/coach.yaml)",
      "Write(.tmp/coach/**)",
      "Write(/.tmp/coach/**)",
      "Read(~/Downloads/*.csv)",
      "Read(~/Desktop/*.csv)"
    ],
    "deny": [
      "Edit(athlete/.cache/**)",
      "Write(athlete/.cache/**)",
      "Edit(/athlete/.cache/**)",
      "Write(/athlete/.cache/**)"
    ]
  }
}
